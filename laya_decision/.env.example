# Configuração do Laya Decision Service
# Copie para .env e ajuste conforme necessário.

# Caminho ou ID do modelo Laya no Hugging Face (usa o cache local existente em ~/.cache/huggingface/hub)
LAYA_MODEL_ID=convaiinnovations/laya

# Dispositivo de execução (cpu ou cuda). Deixe vazio para detecção automática.
LAYA_DEVICE=cpu

# Limite máximo de tempo para avaliação (segundos)
LAYA_TIMEOUT_SECONDS=15.0

# Limite de tamanho de caracteres para o contexto (previne overflow e ataques de negação de serviço)
LAYA_MAX_CONTEXT_CHARS=4000

# Limiar mínimo de confiança calibrada para decisões autônomas não críticas (0.0 a 1.0)
LAYA_MIN_CONFIDENCE_THRESHOLD=0.7

# Nível de log (DEBUG, INFO, WARNING, ERROR)
LAYA_LOG_LEVEL=INFO

# Modo somente offline (usa cache já presente em disco sem tentar requisições externas)
LAYA_OFFLINE_ONLY=true
